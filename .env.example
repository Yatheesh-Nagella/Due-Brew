# Copy to .env on the Pi and fill in real values. Never commit .env.

APP_ENV=production
TZ=America/Chicago

POSTGRES_USER=duebrew
POSTGRES_PASSWORD=changeme
POSTGRES_DB=duebrew
DATABASE_URL=postgresql+psycopg://duebrew:changeme@db:5432/duebrew

APP_BASE_URL=https://raspberrypi.tailb66afe.ts.net/due-brew

# Email via Brevo's SMTP relay (free plan; see DEPLOY.md section 6). Any SMTP
# provider works: for Gmail use smtp.gmail.com, an app password, and the
# Gmail address as both SMTP_USERNAME and EMAIL_FROM.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=your-smtp-login@smtp-brevo.com
SMTP_PASSWORD=your-brevo-smtp-key
EMAIL_FROM=Due and Brew <your-verified-sender@example.com>

# login:Display Name:email, comma separated. The login is what Tailscale shows
# for each person (the Tailscale-User-Login header).
SEED_USERS=alice@example.com:Alice:alice@example.com,bob@example.com:Bob:bob@example.com

NOTIFIER_INTERVAL_SECONDS=300
OCCURRENCE_HORIZON_DAYS=60
CATCHUP_HOURS=48
STALE_PENDING_MINUTES=10

# Development and tests only; ignored when APP_ENV=production.
NOTIFIER_DRY_RUN=false
NOW_OVERRIDE=
DEV_USER_LOGIN=
