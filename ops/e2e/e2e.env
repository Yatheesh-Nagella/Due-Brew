# Throwaway values for scripts/e2e-local.sh only. Production identity rules apply.
APP_ENV=production
TZ=America/Chicago
POSTGRES_USER=duebrew
POSTGRES_PASSWORD=e2e
POSTGRES_DB=duebrew
DATABASE_URL=postgresql+psycopg://duebrew:e2e@db:5432/duebrew
APP_BASE_URL=http://localhost:8088/due-brew
SEED_USERS=alice@example.com:Alice:alice@example.com,bob@example.com:Bob:bob@example.com
NOTIFIER_INTERVAL_SECONDS=5
# Emails go to the local Mailpit inbox (ops/local/mailpit.compose.yml).
NOTIFIER_DRY_RUN=false
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
EMAIL_FROM=Due and Brew <house@example.com>
