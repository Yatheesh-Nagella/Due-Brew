# Values for scripts/run-local.sh only: development mode, so DEV_USER_LOGIN
# stands in for the Tailscale header a laptop browser doesn't send.
APP_ENV=development
DEV_USER_LOGIN=alice@example.com
TZ=America/Chicago
POSTGRES_USER=duebrew
POSTGRES_PASSWORD=local
POSTGRES_DB=duebrew
DATABASE_URL=postgresql+psycopg://duebrew:local@db:5432/duebrew
APP_BASE_URL=http://localhost:8080/due-brew
SEED_USERS=alice@example.com:Alice:alice@example.com,bob@example.com:Bob:bob@example.com
NOTIFIER_INTERVAL_SECONDS=30
# Emails go to the local Mailpit inbox (ops/local/mailpit.compose.yml).
NOTIFIER_DRY_RUN=false
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
EMAIL_FROM=Due and Brew <house@example.com>
