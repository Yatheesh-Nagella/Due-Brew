# Copy to ops/local/smtp.env (gitignored, never commit it) to make the LOCAL
# app send real email through Brevo instead of catching it in Mailpit.
# scripts/run-local.sh then stops the local notifier so test bills can't email
# the fake @example.com housemates; only Settings -> "Send test email" sends,
# to the email you set in Settings first.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=your-smtp-login@smtp-brevo.com
SMTP_PASSWORD=your-brevo-smtp-key
EMAIL_FROM=Due and Brew <your-verified-sender@example.com>
